{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kit-manifest",
  "title": "Kit manifest",
  "description": "Reference schema for kit.json. scripts/validate-kits.mjs is the enforced source of truth.",
  "type": "object",
  "required": ["name", "description", "owner", "status", "network", "stack", "entry", "time_to_first_run_minutes"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 10 },
    "owner": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "network": { "enum": ["fuji", "mainnet", "both", "none"] },
    "stack": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "entry": { "type": "string" },
    "time_to_first_run_minutes": { "type": "number", "minimum": 1 },
    "skills": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
